# AttendIQ Environment Variables
# Copy to .env and adjust values for your deployment.

# Default admin password (change on first login!)
ADMIN_PASSWORD=admin

# Database path (relative to project root)
DB_PATH=data/users.db

# Camera settings
CAMERA_INDEX=0
FRAME_SCALE=0.25

# Recognition engine: auto | dlib | lbph
RECOGNITION_ENGINE=auto
TOLERANCE=0.6

# Streaming (leave blank for local webcam)
STREAM_URL=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server host and port (used by uvicorn)
HOST=0.0.0.0
PORT=8000

# JWT — generated 2026-09-04 (rotate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=0d9c2a3050290e38f8354b2adbda3f343f39357f382d79c67bb9ccb81456273e
JWT_REFRESH_SECRET=ad8248bf4340a42836913f0be7f5d23af60fc4b7ff772b09d331698cb5d59092
# For production, override via real env vars — do NOT commit .env with real secrets

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
